# Copy this file to .streamlit/secrets.toml and fill in values.
# On Streamlit Community Cloud, add these via the app's Secrets settings panel.

# Optional: enable GPT-4o responses in the AI Guide
OPENAI_API_KEY = ""
USE_AI = "false"

# Optional: change the app secret key
APP_SECRET_KEY = "change-me-in-production"

# OneMap API — get your token from https://www.onemap.gov.sg/apidocs/
# Required for live driving + bus travel times; estimates are used without it
ONEMAP_TOKEN = ""
